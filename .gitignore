*:Zone.Identifier

# Pipeline runtime artifacts
/cache/
/outputs/
*.npy

# Per-project data. Tracked: config.yaml, subcategories/keywords/anchors/groups
# JSON, reference/ concourses, README. Not tracked:
#   data/     corpora (Swissdox-licensed full text, deliberation transcripts)
#             and pipeline artifacts (paragraphs, embeddings)
#   context/  grounding documents (may be confidential, e.g. focus groups)
#   outputs/  generated concourses (regenerable from config)
projects/*/data/
projects/*/context/
projects/*/outputs/

# Corpus-derived text in the thesis-era code (Swissdox excerpts)
legacy/**/*top_500_similarity_score.txt

# IDE / OS
.vscode/
.idea/
.DS_Store
.ipynb_checkpoints/
